{
  "manifest_version": 3,
  "name": "VoiceCoder",
  "version": "2.0.0",
  "description": "From voice to action: speak intentions and VoiceCoder writes, edits and explains code in browser editors.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" },
    "default_title": "VoiceCoder (Alt+Space)"
  },
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/*",
        "https://replit.com/*",
        "https://vscode.dev/*",
        "https://github.dev/*",
        "https://codesandbox.io/*",
        "https://stackblitz.com/*",
        "https://codepen.io/*",
        "https://jsfiddle.net/*",
        "https://www.hackerrank.com/*",
        "https://codeforces.com/*",
        "https://atcoder.jp/*"
      ],
      "js": ["page-bridge.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://leetcode.com/*",
        "https://replit.com/*",
        "https://vscode.dev/*",
        "https://github.dev/*",
        "https://codesandbox.io/*",
        "https://stackblitz.com/*",
        "https://codepen.io/*",
        "https://jsfiddle.net/*",
        "https://www.hackerrank.com/*",
        "https://codeforces.com/*",
        "https://atcoder.jp/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://api.anthropic.com/*", "https://api.openai.com/*"],
  "commands": {
    "toggle-voicecoder": {
      "suggested_key": { "default": "Alt+Space", "mac": "Alt+Space" },
      "description": "Toggle VoiceCoder listening"
    },
    "undo-last": {
      "suggested_key": { "default": "Alt+Z", "mac": "Alt+Z" },
      "description": "Undo the last VoiceCoder change"
    }
  },
  "options_page": "settings/settings.html",
  "minimum_chrome_version": "111"
}
