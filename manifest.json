{
  "manifest_version": 3,
  "name": "VoiceCoder",
  "version": "1.0.0",
  "description": "Talk directly into your code editor. Natural language → real code, instantly at your cursor.",
  "author": "VoiceCoder",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "VoiceCoder (Option+Space)"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/*",
        "https://replit.com/*",
        "https://github.com/*",
        "https://vscode.dev/*",
        "https://github.dev/*",
        "https://codesandbox.io/*",
        "https://stackblitz.com/*",
        "https://codepen.io/*",
        "https://jsfiddle.net/*",
        "https://www.hackerrank.com/*",
        "https://codeforces.com/*",
        "https://atcoder.jp/*",
        "<all_urls>"
      ],
      "js": [
        "src/content/content.js"
      ],
      "css": [
        "src/content/content.css"
      ],
      "type": "module",
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "toggle-voicecoder": {
      "suggested_key": {
        "default": "Alt+Space",
        "mac": "Alt+Space"
      },
      "description": "Toggle VoiceCoder listening mode"
    },
    "switch-language": {
      "suggested_key": {
        "default": "Alt+L",
        "mac": "Alt+L"
      },
      "description": "Switch programming language"
    },
    "undo-last": {
      "suggested_key": {
        "default": "Alt+Z",
        "mac": "Alt+Z"
      },
      "description": "Undo last VoiceCoder insertion"
    }
  },
  "options_page": "src/settings/settings.html",
  "web_accessible_resources": [
    {
      "resources": ["src/content/content.css", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
